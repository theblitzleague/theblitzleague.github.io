rules_version = '2';
// Who may read and write what in the Blitz Hub database. Nothing is allowed unless a rule below says so.
//   config/roles      { owner: uid, commish: [uid] }: owner set from the Firebase side; the owner adds co-commissioners.
//   users/{uid}       one per signed-in person: name, email, and the team the commissioner linked them to.
//   devices/{id}      one per phone that allowed notifications: its owner and its push registration.
//   announcements/{id} commissioner messages; anyone may read them (the home page shows them).
//   notes/{id}        a private commissioner message to one GM; only that GM and the commissioner may read it.
//   drafts/{id}       draft rooms (picks, seats, clock); written only by the draft function. Queues: that GM + commish.
//   live/{id}         live fantasy points during NFL games, written by the liveScores job; public.
//   ledger/{id}       dues, prepayments and payouts; members read, only the owner writes, nothing is edited or deleted.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCommish() {
      return signedIn() && exists(/databases/$(database)/documents/config/roles)
        && request.auth.uid in get(/databases/$(database)/documents/config/roles).data.commish;
    }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    // The League's owner (config/roles.owner): the only person who may write to the ledger.
    function isOwner() {
      return signedIn() && exists(/databases/$(database)/documents/config/roles)
        && get(/databases/$(database)/documents/config/roles).data.owner == request.auth.uid;
    }
    // A league member: the commissioners, or anyone the commissioner has linked to a team.
    function isMember() {
      return isCommish() || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', null) != null);
    }

    // { owner: uid, commish: [uid] }. The owner (set from the Firebase side) may add or remove co-commissioners from the
    // site, but can't change the owner or remove themselves. Nobody else can change it from the site.
    // League scoring versions (written only by the "settings" function, for the commissioner). Anyone can read them:
    // every page scores games with them, and the nightly data build reads them without signing in.
    // Season tools (functions "season"): the record book of finished Hub seasons and the open dues/draft season.
    // Public like the rest of the league's results; written only by the server.
    match /history/{season} {
      allow read: if true;
      allow write: if false;
    }
    match /config/season {
      allow read: if true;
      allow write: if false;
    }
    match /config/scoring {
      allow read: if true;
      allow write: if false;
    }
    match /config/roles {
      allow read: if signedIn();
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'commish'])
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.commish is list && request.resource.data.commish.size() <= 5
        && resource.data.owner in request.resource.data.commish;
      allow create, delete: if false;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isCommish());
      // A person creates their own record, without a team; only the commissioner assigns teams.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'at'])
        && (request.resource.data.name == null || request.resource.data.name is string && request.resource.data.name.size() <= 80)
        && (request.resource.data.email == null || request.resource.data.email is string && request.resource.data.email.size() <= 200);
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'at'])
          && (request.resource.data.name == null || request.resource.data.name is string && request.resource.data.name.size() <= 80))
        || (isCommish() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['team'])
          && (request.resource.data.team == null || request.resource.data.team is int && request.resource.data.team >= 1 && request.resource.data.team <= 32)));
      allow delete: if isCommish();
    }

    match /devices/{id} {
      allow read, delete: if signedIn() && (resource.data.uid == request.auth.uid || isCommish());
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'token', 'at', 'device'])
        && text(request.resource.data.token, 4096)
        && (request.resource.data.device == null || request.resource.data.device is string && request.resource.data.device.size() <= 120);
    }

    // Private messages: one copy per recipient GM.
    match /notes/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || isCommish());
      allow create: if isCommish()
        && request.resource.data.keys().hasOnly(['to', 'team', 'title', 'body', 'by', 'at'])
        && text(request.resource.data.to, 128)
        && (request.resource.data.team == null || request.resource.data.team is int)
        && text(request.resource.data.title, 80) && text(request.resource.data.body, 1000)
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isCommish();
      allow update: if false;
    }

    // The League ledger (rule 6-4-3): every dues payment, prepayment and prize payout. Members read it; only the owner
    // writes it, and nothing is ever edited or deleted. A mistake is fixed by a "void" entry that cancels another one.
    match /ledger/{id} {
      allow read: if isMember();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['season', 'kind', 'team', 'amount', 'prize', 'week', 'note', 'ref', 'at', 'by'])
        && request.resource.data.kind in ['dues', 'prepay', 'payout', 'void']
        && request.resource.data.season is int && request.resource.data.season >= 2026 && request.resource.data.season <= 2100
        && request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 2000
        && (request.resource.data.team == null || request.resource.data.team is int && request.resource.data.team >= 1 && request.resource.data.team <= 32)
        && (request.resource.data.prize == null || text(request.resource.data.prize, 40))
        && (request.resource.data.week == null || request.resource.data.week is int)
        && (request.resource.data.note == null || request.resource.data.note is string && request.resource.data.note.size() <= 300)
        && (request.resource.data.kind != 'void' || text(request.resource.data.ref, 128) && text(request.resource.data.note, 300))
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // Draft room: anyone signed in may watch; every change goes through the draft function (functions/index.js), which
    // checks turns, the clock and the rules. A team's queue is visible only to its GM and the commissioners.
    // A finished draft's board is public (the Draft page's Past drafts tab reads it without sign-in); drafts still in
    // progress, their player pools and queues need sign-in as before.
    match /drafts/{id} {
      allow read: if signedIn() || resource.data.status == 'done';
      allow write: if false;
      match /pool/{doc} {
        allow read: if signedIn();
        allow write: if false;
      }
      match /queues/{team} {
        allow read: if signedIn() && (isCommish() || get(/databases/$(database)/documents/drafts/$(id)).data.seats.get(team, '') == request.auth.uid);
        allow write: if false;
      }
    }

    // The Hub's own league: league/rosters is written by the draft function when the commissioner marks a draft official
    // (and later by lineups, waivers and trades). Anyone may read it, like the rest of the site; only the functions write.
    match /league/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // Waiver claims are blind: a claim is readable only by its team's GM (users/{uid}.team) and the commissioners.
    // Every change goes through the moves function. Transactions (completed adds, drops, claims, trades) are public.
    match /claims/{id} {
      allow read: if signedIn() && (isCommish() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', -1) == resource.data.team);
      allow write: if false;
    }
    // Trades: an open offer is visible to the two teams and the commissioners; once accepted (in review) or decided, everyone.
    match /trades/{id} {
      allow read: if resource.data.status in ['review', 'processed', 'vetoed', 'failed']
        || signedIn() && (isCommish()
          || resource.data.from == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', -1)
          || resource.data.to == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('team', -1));
      allow write: if false;
    }
    match /transactions/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Each week's final Hub scores (functions/index.js weekResults). Anyone may read; standings are built from them.
    match /results/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Each week's Hub lineups as they stood (written by the lineup function and liveScores). Anyone may read.
    match /lineups/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Live fantasy points while NFL games are on (functions/index.js liveScores). Anyone may read; only that job writes.
    match /live/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /announcements/{id} {
      allow read: if true;
      allow create: if isCommish()
        && request.resource.data.keys().hasOnly(['title', 'body', 'by', 'at'])
        && text(request.resource.data.title, 80) && text(request.resource.data.body, 1000)
        && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
      allow delete: if isCommish();
      allow update: if false;   // the sender (functions/index.js) records results with server access, which skips these rules
    }
  }
}
